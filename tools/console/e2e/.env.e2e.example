# Midscene E2E 模型配置示例
#
# 用法：cp .env.e2e.example .env.e2e，填真值。.env.e2e 已 gitignore——它承载内部网关域名与
# 密钥，绝不提交（安全红线：本仓任何入库文件不得出现公司内部域名/服务名/包 scope，guard 会拦）。
#
# 变量名以 @midscene/shared 1.10.x 实际读取的 MIDSCENE_MODEL_* 为准；
# 老文档的 OPENAI_API_KEY / MIDSCENE_USE_QWEN_VL 是 legacy 路径，别用。
# 注意：Midscene 1.10.x 不支持 Claude 系列模型，别往这儿填。

MIDSCENE_MODEL_BASE_URL=<OpenAI 兼容网关地址，通常带 /v1>
MIDSCENE_MODEL_API_KEY=<key>
MIDSCENE_MODEL_NAME=<支持图片输入的模型名>
MIDSCENE_MODEL_FAMILY=<模型族；必填——不设会走通用分支，元素定位系统性偏移>

# 看板地址（默认 http://127.0.0.1:5170；dev 联调可指 vite dev 端口）
# CONSOLE_URL=http://127.0.0.1:5170

# 可选调参（env.ts 已给缺省）
# MIDSCENE_MODEL_TIMEOUT=60000
# MIDSCENE_MODEL_RETRY_COUNT=2
# MIDSCENE_PREFERRED_LANGUAGE=zh-CN

# 排查定位不准时打开
# MIDSCENE_DEBUG_MODEL_RESPONSE=1
